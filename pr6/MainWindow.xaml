<Window x:Class="pr6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr6"
        mc:Ignorable="d"
        Title="Телевизор" Height="450" Width="800" MinWidth="800" MinHeight="450" FontFamily="Arial Narrow">
    <Grid Background="#FF383838">
        <Label
            x:Name="NameChannel"
            Content=""
            HorizontalAlignment="Left"
            Margin="20,10,0,0"
            VerticalAlignment="Top"
            Foreground="White"/>
        <MediaElement
            x:Name="VideoPlayer"
            LoadedBehavior="Manual"
            Volume="1"
            Stretch="UniformToFill"
            Margin="20,41,19.6,50"/>
        <Grid
            Margin="0,0,0,0"
            Height="50"
            VerticalAlignment="Bottom">
            <Button
                Click="BackChannel"
                Content="Назад"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Width="100"
                Height="25"
                Margin="10,0,0,10"
                Background="White"/>
            <Button
                Click="NextChannel"
                Content="Вперёд"
                HorizontalAlignment="Left"
                Margin="115,0,0,10"
                VerticalAlignment="Bottom"
                Width="100"
                Height="25"
                Background="White"/>
            <Button
                Click="DownSound"
                Content="Тише"
                HorizontalAlignment="Right"
                Margin="0,0,115,10"
                VerticalAlignment="Bottom"
                Width="100"
                Height="25"
                Background="White"/>
            <Button
                Click="UpSound"
                Content="Громче"
                HorizontalAlignment="Right"
                Margin="0,0,10,10"
                VerticalAlignment="Bottom"
                Width="100"
                Height="25"
                Background="White"/>
            <TextBox x:Name="SelectChanell" HorizontalAlignment="Left" Margin="465,16,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="26" Height="24"/>
            <Button
                Click="SelectChanel"
                Content="Выбрать канал"
                HorizontalAlignment="Right"
                Margin="0,0,229,10"
                VerticalAlignment="Bottom"
                Width="75"
                Height="25"
                Background="White" RenderTransformOrigin="1.087,0.573"/>
            <Button
                Click="BackShow"
                Content="("
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Width="100"
                Height="25"
                Margin="245,0,0,10"
                Background="White"/>
            <Button
                Click="NextShow"
                Content=")"
                HorizontalAlignment="Center"
                Margin="0,15,0,0"
                VerticalAlignment="Top"
                Width="100"
                Height="25"
                Background="White"/>
        </Grid>
    </Grid>
</Window>

